{% extends 'base.html.twig' %}

{% block title %}Users — kimbo{% endblock %}

{% block body %}
<div class="card shadow-sm">

    <div class="card-header bg-body-tertiary">
        <form method="post" action="{{ path('app_users_action') }}" id="toolbarForm"
              class="d-flex flex-wrap gap-2 align-items-center">
            <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
            <input type="hidden" name="action" id="actionField" value="">
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir"  value="{{ dir }}">

            <button type="submit" class="btn btn-outline-primary btn-sm js-needs-selection"
                    data-action="block"
                    data-bs-toggle="tooltip" data-bs-placement="bottom"
                    title="Block selected users" disabled>
                <i class="bi bi-lock-fill" aria-hidden="true"></i> Block
            </button>

            <button type="submit" class="btn btn-outline-primary btn-sm js-needs-selection"
                    data-action="unblock"
                    data-bs-toggle="tooltip" data-bs-placement="bottom"
                    title="Unblock selected users"
                    aria-label="Unblock selected users" disabled>
                <i class="bi bi-unlock-fill" aria-hidden="true"></i>
            </button>

            <button type="submit" class="btn btn-outline-danger btn-sm js-needs-selection"
                    data-action="delete"
                    data-bs-toggle="tooltip" data-bs-placement="bottom"
                    title="Delete selected users"
                    aria-label="Delete selected users" disabled>
                <i class="bi bi-trash-fill" aria-hidden="true"></i>
            </button>

            <button type="submit" class="btn btn-outline-danger btn-sm"
                    data-action="delete_unverified"
                    data-bs-toggle="tooltip" data-bs-placement="bottom"
                    title="Delete all unverified users"
                    aria-label="Delete all unverified users"
                    {{ unverifiedCount == 0 ? 'disabled' : '' }}>
                <i class="bi bi-person-x-fill" aria-hidden="true"></i>
            </button>

            <span class="text-secondary small ms-1" id="selectionCounter"></span>

            <div class="ms-auto" style="min-width: 220px;">
                <label for="filterInput" class="visually-hidden">Filter</label>
                <input type="text" class="form-control form-control-sm" id="filterInput"
                       placeholder="Filter" autocomplete="off">
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-start" style="width: 2.5rem;">
                        <input class="form-check-input mt-0" type="checkbox" id="selectAll"
                               aria-label="Select all users">
                    </th>

                    <th scope="col" class="text-start">
                        <a class="th-sort" href="{{ path('app_users', {sort: 'name', dir: sort == 'name' and dir == 'asc' ? 'desc' : 'asc'}) }}">
                            Name
                            {% if sort == 'name' %}
                                <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th scope="col" class="text-start">
                        <a class="th-sort" href="{{ path('app_users', {sort: 'email', dir: sort == 'email' and dir == 'asc' ? 'desc' : 'asc'}) }}">
                            Email
                            {% if sort == 'email' %}
                                <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th scope="col" class="text-start">
                        <a class="th-sort" href="{{ path('app_users', {sort: 'status', dir: sort == 'status' and dir == 'asc' ? 'desc' : 'asc'}) }}">
                            Status
                            {% if sort == 'status' %}
                                <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th scope="col" class="text-start">
                        <a class="th-sort" href="{{ path('app_users', {sort: 'lastSeen', dir: sort == 'lastSeen' and dir == 'asc' ? 'desc' : 'asc'}) }}">
                            Last seen
                            {% if sort == 'lastSeen' %}
                                <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    </th>
                    <th scope="col" class="text-start d-none d-md-table-cell">
                        <a class="th-sort" href="{{ path('app_users', {sort: 'createdAt', dir: sort == 'createdAt' and dir == 'asc' ? 'desc' : 'asc'}) }}">
                            Registered
                            {% if sort == 'createdAt' %}
                                <i class="bi bi-arrow-{{ dir == 'asc' ? 'up' : 'down' }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    </th>
                </tr>
            </thead>

            <tbody>
            {% for user in users %}
                <tr class="{{ user.status == 'blocked' ? 'row-blocked' : '' }}">
                    <td class="text-start">
                        <input class="form-check-input mt-0 js-row-check" type="checkbox"
                               name="ids[]" value="{{ user.id }}" form="toolbarForm"
                               aria-label="Select {{ user.name }}">
                    </td>

                    <td class="text-start">
                        <span class="user-name">{{ user.name }}</span>
                        {% if user.id == app.user.id %}
                            <span class="badge text-bg-secondary ms-1">you</span>
                        {% endif %}
                    </td>

                    <td class="text-start">{{ user.email }}</td>

                    <td class="text-start">
                        {% if user.status == 'active' %}
                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">Active</span>
                        {% elseif user.status == 'blocked' %}
                            <span class="badge rounded-pill bg-danger-subtle text-danger-emphasis border border-danger-subtle">Blocked</span>
                        {% else %}
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">Unverified</span>
                        {% endif %}
                    </td>

                    <td class="text-start"
                        {% if user.lastSeenAt %}
                            data-bs-toggle="tooltip" data-bs-placement="bottom"
                            title="{{ user.lastSeenAt|date('F j, Y H:i:s') }}"
                        {% endif %}>
                        {{ user.lastSeenAt|ago }}
                    </td>

                    <td class="text-start d-none d-md-table-cell"
                        data-bs-toggle="tooltip" data-bs-placement="bottom"
                        title="{{ user.createdAt|date('F j, Y H:i:s') }}">
                        {{ user.createdAt|ago }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-secondary py-4">
                        No users yet.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-body-tertiary text-secondary small">
        Total: {{ users|length }} · Unverified: {{ unverifiedCount }}
    </div>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1"
     aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Please confirm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmText"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm"
                        id="confirmOk">Delete</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/app.js') }}"></script>
{% endblock %}
